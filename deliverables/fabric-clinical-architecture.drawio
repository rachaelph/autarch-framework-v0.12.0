        </mxCell>
        <mxCell id="tr-c51" value="NO AGENTS IN THIS HORIZON&#10;Name a workstream owner per horizon&#10;Stand up architecture review with veto" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#D4FF3F;strokeWidth=2;fontFamily=Helvetica;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;fontColor=#8A7F66;" vertex="1" parent="1">
          <mxGeometry x="280" y="620" width="308" height="93" as="geometry" />
        </mxCell>
        <mxCell id="tr-c52" value="Ontology DESIGN only — no build&#10;Data product ownership model agreed&#10;Intake process for new sources" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#D8D2C4;fontFamily=Helvetica;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="596" y="620" width="308" height="93" as="geometry" />
        </mxCell>
        <mxCell id="tr-c53" value="FIRST AGENT — read-only, one use case&#10;Database Lock Readiness scorecard&#10;Proves grounding, citation and audit" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#1A7A1A;strokeWidth=2;fontFamily=Helvetica;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="912" y="620" width="308" height="93" as="geometry" />
        </mxCell>
        <mxCell id="tr-c54" value="Agent factory — certified, reusable&#10;Human-in-the-loop on every write&#10;Continuous learning from expert feedback" style="rounded=0;html=1;fillColor=#0B0B0B;strokeColor=#D4FF3F;strokeWidth=2;fontFamily=Helvetica;fontSize=11;fontColor=#D4FF3F;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1228" y="620" width="308" height="93" as="geometry" />
        </mxCell>

        <mxCell id="tr-gh" value="GATE TO PROCEED" style="rounded=0;html=1;fillColor=#1A7A1A;strokeColor=#1A7A1A;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#FFFFFF;align=left;spacingLeft=10;verticalAlign=middle;letterSpacing=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="718" width="190" height="72" as="geometry" />
        </mxCell>
        <mxCell id="tr-g1" value="Sponsor path persisted and load-tested.&#10;Capacity metrics prove serving is isolated." style="rounded=0;html=1;fillColor=#EDEAE3;strokeColor=#1A7A1A;fontFamily=Helvetica;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="280" y="718" width="308" height="72" as="geometry" />
        </mxCell>
        <mxCell id="tr-g2" value="Masters live. One metric canon published.&#10;A contract violation demonstrably blocks a load." style="rounded=0;html=1;fillColor=#EDEAE3;strokeColor=#1A7A1A;fontFamily=Helvetica;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="596" y="718" width="308" height="72" as="geometry" />
        </mxCell>
        <mxCell id="tr-g3" value="Legacy off with a date. Reconciliation clean.&#10;First agent cites Gold and passes audit review." style="rounded=0;html=1;fillColor=#EDEAE3;strokeColor=#1A7A1A;fontFamily=Helvetica;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="912" y="718" width="308" height="72" as="geometry" />
        </mxCell>
        <mxCell id="tr-g4" value="Target state on pages 01 and 02 reached.&#10;Steady-state operating model owns it." style="rounded=0;html=1;fillColor=#0B0B0B;strokeColor=#D4FF3F;fontFamily=Helvetica;fontSize=11;fontColor=#D4FF3F;align=left;spacingLeft=10;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="1228" y="718" width="308" height="72" as="geometry" />
        </mxCell>

        <mxCell id="tr-a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1A7A1A;strokeWidth=3;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="tr-h0" target="tr-h1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tr-a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1A7A1A;strokeWidth=3;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="tr-h1" target="tr-h2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tr-a3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1A7A1A;strokeWidth=3;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="tr-h2" target="tr-h3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="tr-foot" value="H0 is the only horizon that can start without further evidence — it is remediation of a known, evidenced defect. H1 onward depends on discovery outputs. Agents deliberately do not appear until H2, and then read-only: an agent grounded on view-based Gold with no metric canon would be fast, fluent and wrong, carrying the platform's authority while being wrong. Sequence is the risk control." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#8A7F66;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="800" width="1456" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="page-medallion" name="05 · Medallion — corrected for clinical">
    <mxGraphModel dx="1900" dy="1050" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="950" math="0" shadow="0" background="#F7F4EC">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="md-title" value="Microsoft Fabric medallion — corrected for regulated clinical data" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Georgia;fontSize=32;fontStyle=1;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="60" y="34" width="1200" height="44" as="geometry" />
        </mxCell>
        <mxCell id="md-sub" value="The reference pattern is right. It omits persistence, isolation, contracts and ownership — and those four omissions are where the incident came from. Each layer below carries one non-negotiable that closes the gap." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="62" y="82" width="1400" height="24" as="geometry" />
        </mxCell>
        <mxCell id="md-badge" value="TARGET — CORRECTS THE REFERENCE DIAGRAM" style="rounded=0;html=1;fillColor=#0B0B0B;strokeColor=#D4FF3F;strokeWidth=2;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#D4FF3F;letterSpacing=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1300" y="34" width="330" height="32" as="geometry" />
        </mxCell>

        <mxCell id="md-src" value="DATA SOURCES" style="swimlane;html=1;startSize=34;fillColor=#0B0B0B;strokeColor=#0B0B0B;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#D4FF3F;align=left;spacingLeft=12;letterSpacing=1;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="145" width="200" height="550" as="geometry" />
        </mxCell>
        <mxCell id="md-s1" value="CLINICAL&lt;br&gt;&lt;br&gt;Veeva EDC — REST · ZIP/CSV&lt;br&gt;Medidata Rave — SOAP · ODM XML&lt;br&gt;Veeva CTMS / UCV — Direct Data API&lt;br&gt;Central labs · IRT/RTSM&lt;br&gt;ePRO / eCOA · Safety (Argus)&lt;br&gt;eTMF" style="rounded=0;html=1;fillColor=#1F1F1F;strokeColor=#3A3A3A;fontFamily=Helvetica;fontSize=10;fontColor=#FFFFFF;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="md-src">
          <mxGeometry x="12" y="42" width="176" height="150" as="geometry" />
        </mxCell>
        <mxCell id="md-s2" value="ENTERPRISE&lt;br&gt;&lt;br&gt;Salesforce · Conga · HubSpot&lt;br&gt;Responsive · Workday&lt;br&gt;Adaptive · BlackLine" style="rounded=0;html=1;fillColor=#1F1F1F;strokeColor=#3A3A3A;fontFamily=Helvetica;fontSize=10;fontColor=#FFFFFF;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="md-src">
          <mxGeometry x="12" y="204" width="176" height="100" as="geometry" />
        </mxCell>
        <mxCell id="md-s3" value="LEGACY — RETIRING&lt;br&gt;&lt;br&gt;ODW · SDW · Snowflake&lt;br&gt;Informatica · TIBCO · Matillion" style="rounded=0;html=1;fillColor=#1F1F1F;strokeColor=#8A7F66;dashed=1;fontFamily=Helvetica;fontSize=10;fontColor=#BBBBBB;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="md-src">
          <mxGeometry x="12" y="316" width="176" height="86" as="geometry" />
        </mxCell>
        <mxCell id="md-s4" value="Not &quot;any source, any format&quot;.&lt;br&gt;Each one has a watermark, a&lt;br&gt;deletion semantic and an&lt;br&gt;atomicity requirement that&lt;br&gt;must be designed for." style="rounded=0;html=1;fillColor=none;strokeColor=#D4FF3F;fontFamily=Helvetica;fontSize=10;fontColor=#D4FF3F;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=2;" vertex="1" parent="md-src">
          <mxGeometry x="12" y="414" width="176" height="92" as="geometry" />
        </mxCell>

        <mxCell id="md-orch" value="ORCHESTRATE &amp; PROCESS          Data Factory pipelines  ·  Notebooks (Spark)  ·  Dataflow Gen2  ·  T-SQL          —          one control plane, dependency-based, not time-based" style="rounded=0;html=1;fillColor=#EDEAE3;strokeColor=#1A7A1A;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#1A7A1A;align=left;spacingLeft=16;verticalAlign=middle;letterSpacing=1;" vertex="1" parent="1">
          <mxGeometry x="285" y="145" width="1345" height="60" as="geometry" />
        </mxCell>

        <mxCell id="md-bronze" value="BRONZE — RAW, REPLAYABLE" style="swimlane;html=1;startSize=36;fillColor=#FDF3E3;strokeColor=#B87333;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#8A5A1E;align=left;spacingLeft=14;letterSpacing=1;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="285" y="225" width="325" height="470" as="geometry" />
        </mxCell>
        <mxCell id="md-b1" value="Land exactly as received.&lt;br&gt;&lt;b&gt;Never interpret.&lt;/b&gt;" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#E0D5C0;fontFamily=Helvetica;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="md-bronze">
          <mxGeometry x="14" y="44" width="297" height="46" as="geometry" />
        </mxCell>
        <mxCell id="md-b2" value="&lt;b&gt;NON-NEGOTIABLE&lt;/b&gt;&lt;br&gt;APPEND-ONLY. Never overwritten,&lt;br&gt;never merged. A retraction lands as&lt;br&gt;a new row — the original is kept." style="rounded=0;html=1;fillColor=#0B0B0B;strokeColor=#D4FF3F;strokeWidth=2;fontFamily=Helvetica;fontSize=10;fontColor=#D4FF3F;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="md-bronze">
          <mxGeometry x="14" y="100" width="297" height="76" as="geometry" />
        </mxCell>
        <mxCell id="md-b3" value="&lt;b&gt;Lineage stamped on every row&lt;/b&gt;&lt;br&gt;_source_system · _batch_id&lt;br&gt;_ingest_ts · _source_modified_ts&lt;br&gt;_transaction_type · _payload_hash&lt;br&gt;_row_hash" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#E0D5C0;fontFamily=Helvetica;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontFamily=Courier New;" vertex="1" parent="md-bronze">
          <mxGeometry x="14" y="186" width="297" height="86" as="geometry" />
        </mxCell>
        <mxCell id="md-b4" value="&lt;b&gt;Atomicity&lt;/b&gt;  A batch is all-or-nothing.&lt;br&gt;Partial ZIP fails; the watermark does&lt;br&gt;not advance. Source count reconciles&lt;br&gt;to landed count or the load stops." style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#E0D5C0;fontFamily=Helvetica;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="md-bronze">
          <mxGeometry x="14" y="282" width="297" height="74" as="geometry" />
        </mxCell>
        <mxCell id="md-b5" value="&lt;b&gt;Clinical example&lt;/b&gt;&lt;br&gt;Rave TransactionType=Remove is a real&lt;br&gt;retraction. Ignore it and the lake keeps&lt;br&gt;data the source withdrew — a data&lt;br&gt;integrity finding, not a bug." style="rounded=0;html=1;fillColor=#F7F0E2;strokeColor=#B87333;fontFamily=Helvetica;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="md-bronze">
          <mxGeometry x="14" y="366" width="297" height="86" as="geometry" />
        </mxCell>

        <mxCell id="md-silver" value="SILVER — CONFORMED CLINICAL MODEL" style="swimlane;html=1;startSize=36;fillColor=#EEF2F6;strokeColor=#7B8FA1;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#3F5666;align=left;spacingLeft=14;letterSpacing=1;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="625" y="225" width="325" height="470" as="geometry" />
        </mxCell>
        <mxCell id="md-v1" value="One shared language across every&lt;br&gt;source. &lt;b&gt;Source-agnostic by design.&lt;/b&gt;" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#D5DEE6;fontFamily=Helvetica;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="md-silver">
          <mxGeometry x="14" y="44" width="297" height="46" as="geometry" />
        </mxCell>
        <mxCell id="md-v2" value="&lt;b&gt;NON-NEGOTIABLE&lt;/b&gt;&lt;br&gt;Data contracts enforced as BLOCKING&lt;br&gt;gates. A violation quarantines the rows&lt;br&gt;and stops promotion. Not a warning." style="rounded=0;html=1;fillColor=#0B0B0B;strokeColor=#D4FF3F;strokeWidth=2;fontFamily=Helvetica;fontSize=10;fontColor=#D4FF3F;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="md-silver">
          <mxGeometry x="14" y="100" width="297" height="76" as="geometry" />
        </mxCell>
        <mxCell id="md-v3" value="&lt;b&gt;CDISC SDTM-aligned&lt;/b&gt;&lt;br&gt;DM · SV · AE · LB · VS · EX · CM · DS&lt;br&gt;&lt;b&gt;plus operational&lt;/b&gt; — site, investigator,&lt;br&gt;monitoring visit, query, deviation&lt;br&gt;(do not force these into SDTM)" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#D5DEE6;fontFamily=Helvetica;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="md-silver">
          <mxGeometry x="14" y="186" width="297" height="86" as="geometry" />
        </mxCell>
        <mxCell id="md-v4" value="&lt;b&gt;Identity resolution — the hard part&lt;/b&gt;&lt;br&gt;Subject crosswalk EDC ↔ Rave ↔ IRT ↔ lab&lt;br&gt;with a survivorship rule, a confidence&lt;br&gt;flag and a visible exception queue.&lt;br&gt;MedDRA / WHODrug / CT version per row." style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#7B8FA1;fontFamily=Helvetica;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="md-silver">
          <mxGeometry x="14" y="282" width="297" height="86" as="geometry" />
        </mxCell>
        <mxCell id="md-v5" value="&lt;b&gt;Clinical example&lt;/b&gt;&lt;br&gt;A study on Veeva and a study on Rave&lt;br&gt;land in the same slv_ae. One query&lt;br&gt;answers &quot;all SAEs across my studies&quot;.&lt;br&gt;&lt;b&gt;That sentence is the business case.&lt;/b&gt;" style="rounded=0;html=1;fillColor=#E4EAF0;strokeColor=#7B8FA1;fontFamily=Helvetica;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="md-silver">
          <mxGeometry x="14" y="378" width="297" height="76" as="geometry" />
        </mxCell>

        <mxCell id="md-gold" value="GOLD — PERSISTED, INSPECTION-READY" style="swimlane;html=1;startSize=36;fillColor=#FFF8E1;strokeColor=#C9A227;strokeWidth=3;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#8A6D0B;align=left;spacingLeft=14;letterSpacing=1;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="965" y="225" width="325" height="470" as="geometry" />
        </mxCell>
        <mxCell id="md-g1" value="The answer, agreed once, served fast.&lt;br&gt;Warehouse · Lakehouse · Direct Lake" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#EBDCA8;fontFamily=Helvetica;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="md-gold">
          <mxGeometry x="14" y="44" width="297" height="46" as="geometry" />
        </mxCell>
        <mxCell id="md-g2" value="&lt;b&gt;NON-NEGOTIABLE&lt;/b&gt;&lt;br&gt;PERSISTED DELTA TABLES maintained by&lt;br&gt;incremental MERGE.&lt;br&gt;&lt;b&gt;NEVER VIEWS. NEVER FULL REBUILD.&lt;/b&gt;" style="rounded=0;html=1;fillColor=#0B0B0B;strokeColor=#D4FF3F;strokeWidth=3;fontFamily=Helvetica;fontSize=10;fontColor=#D4FF3F;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="md-gold">
          <mxGeometry x="14" y="100" width="297" height="76" as="geometry" />
        </mxCell>
        <mxCell id="md-g3" value="&lt;b&gt;Read cost, written plainly&lt;/b&gt;&lt;br&gt;Views:  O(full Silver chain) × readers × reads&lt;br&gt;Persisted:  O(scan one table)&lt;br&gt;Write cost paid once, by the transform&lt;br&gt;capacity — not by the sponsor." style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#C9A227;fontFamily=Helvetica;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="md-gold">
          <mxGeometry x="14" y="186" width="297" height="86" as="geometry" />
        </mxCell>
        <mxCell id="md-g4" value="&lt;b&gt;One metric canon&lt;/b&gt;  Enrolled subject,&lt;br&gt;screen failure, data entry lag, query&lt;br&gt;ageing — defined once, versioned, owned.&lt;br&gt;Report-level metric logic is banned." style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#EBDCA8;fontFamily=Helvetica;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="md-gold">
          <mxGeometry x="14" y="282" width="297" height="74" as="geometry" />
        </mxCell>
        <mxCell id="md-g5" value="&lt;b&gt;Sponsor scoping is STRUCTURAL&lt;/b&gt;&lt;br&gt;One workspace per sponsor, read-only&lt;br&gt;shortcut to scoped Gold. A bug in a&lt;br&gt;WHERE clause must not be able to&lt;br&gt;cross a confidentiality boundary." style="rounded=0;html=1;fillColor=#FBF1CE;strokeColor=#C9A227;fontFamily=Helvetica;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="md-gold">
          <mxGeometry x="14" y="366" width="297" height="88" as="geometry" />
        </mxCell>

        <mxCell id="md-serve" value="SERVING — TWO PLANES, ONE TRUTH" style="swimlane;html=1;startSize=36;fillColor=#0B0B0B;strokeColor=#1A7A1A;strokeWidth=3;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#D4FF3F;align=left;spacingLeft=14;letterSpacing=1;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="1305" y="225" width="325" height="470" as="geometry" />
        </mxCell>
        <mxCell id="md-p1" value="&lt;b&gt;ANALYTICAL PLANE&lt;/b&gt;&lt;br&gt;Power BI Direct Lake · sponsor share&lt;br&gt;Biostatistics → ADaM → submission&lt;br&gt;Aggregation, trend, cohort, cross-study" style="rounded=0;html=1;fillColor=#1F1F1F;strokeColor=#3A3A3A;fontFamily=Helvetica;fontSize=10;fontColor=#FFFFFF;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="md-serve">
          <mxGeometry x="14" y="44" width="297" height="76" as="geometry" />
        </mxCell>
        <mxCell id="md-p2" value="&lt;b&gt;TRANSACTIONAL PLANE&lt;/b&gt;&lt;br&gt;Source apps → Azure Service Bus →&lt;br&gt;Azure SQL (EDSL) → applications&lt;br&gt;~50k concurrent · sub-second lookup" style="rounded=0;html=1;fillColor=#1F1F1F;strokeColor=#3A3A3A;fontFamily=Helvetica;fontSize=10;fontColor=#FFFFFF;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="md-serve">
          <mxGeometry x="14" y="130" width="297" height="76" as="geometry" />
        </mxCell>
        <mxCell id="md-p3" value="&lt;b&gt;NON-NEGOTIABLE&lt;/b&gt;&lt;br&gt;The boundary is written down.&lt;br&gt;Aggregation on the lake. Single-record&lt;br&gt;lookup on EDSL. The two planes are&lt;br&gt;RECONCILED by a control, not assumed." style="rounded=0;html=1;fillColor=#0B0B0B;strokeColor=#D4FF3F;strokeWidth=2;fontFamily=Helvetica;fontSize=10;fontColor=#D4FF3F;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="md-serve">
          <mxGeometry x="14" y="216" width="297" height="86" as="geometry" />
        </mxCell>
        <mxCell id="md-p4" value="&lt;b&gt;AGENTS&lt;/b&gt;&lt;br&gt;Ground on Gold and the semantic model&lt;br&gt;ONLY — never Bronze, never Silver.&lt;br&gt;Agents propose. Humans dispose.&lt;br&gt;Every action cited, signed, audited." style="rounded=0;html=1;fillColor=#1F1F1F;strokeColor=#8FCE00;fontFamily=Helvetica;fontSize=10;fontColor=#8FCE00;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="md-serve">
          <mxGeometry x="14" y="312" width="297" height="86" as="geometry" />
        </mxCell>
        <mxCell id="md-p5" value="Nothing outside engineering reads&lt;br&gt;below Gold. Every exception is a&lt;br&gt;governance failure with a name on it." style="rounded=0;html=1;fillColor=none;strokeColor=#5A5A5A;dashed=1;fontFamily=Helvetica;fontSize=10;fontColor=#BBBBBB;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontStyle=2;" vertex="1" parent="md-serve">
          <mxGeometry x="14" y="408" width="297" height="50" as="geometry" />
        </mxCell>

        <mxCell id="md-gov" value="GOVERNANCE — ENFORCED AT A NAMED POINT, NOT AN OUTCOME AT THE BOTTOM OF A SLIDE" style="swimlane;html=1;startSize=32;fillColor=#EDEAE3;strokeColor=#1A7A1A;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#1A7A1A;align=left;spacingLeft=14;letterSpacing=1;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="710" width="1570" height="100" as="geometry" />
        </mxCell>
        <mxCell id="md-gov1" value="&lt;b&gt;Entra · Zero Trust&lt;/b&gt;&lt;br&gt;RLS / CLS enforced in OneLake,&lt;br&gt;not only in the semantic model" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#D8D2C4;fontFamily=Helvetica;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;" vertex="1" parent="md-gov">
          <mxGeometry x="14" y="40" width="246" height="52" as="geometry" />
        </mxCell>
        <mxCell id="md-gov2" value="&lt;b&gt;Purview&lt;/b&gt;&lt;br&gt;Catalog · lineage to source field&lt;br&gt;Sensitivity labels · DLP" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#D8D2C4;fontFamily=Helvetica;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;" vertex="1" parent="md-gov">
          <mxGeometry x="270" y="40" width="246" height="52" as="geometry" />
        </mxCell>
        <mxCell id="md-gov3" value="&lt;b&gt;GxP — 21 CFR Part 11 · ALCOA+&lt;/b&gt;&lt;br&gt;Audit trail · e-signature on every&lt;br&gt;agent approval · CSA validation" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#1A7A1A;strokeWidth=2;fontFamily=Helvetica;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;" vertex="1" parent="md-gov">
          <mxGeometry x="526" y="40" width="246" height="52" as="geometry" />
        </mxCell>
        <mxCell id="md-gov4" value="&lt;b&gt;CAPACITY ISOLATION&lt;/b&gt;&lt;br&gt;Serving NEVER shares a capacity&lt;br&gt;with transformation or exploration" style="rounded=0;html=1;fillColor=#0B0B0B;strokeColor=#D4FF3F;strokeWidth=2;fontFamily=Helvetica;fontSize=10;fontColor=#D4FF3F;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;" vertex="1" parent="md-gov">
          <mxGeometry x="782" y="40" width="246" height="52" as="geometry" />
        </mxCell>
        <mxCell id="md-gov5" value="&lt;b&gt;Named ownership&lt;/b&gt;&lt;br&gt;One owner per layer and per Gold&lt;br&gt;object. Authority, not just duty." style="rounded=0;html=1;fillColor=#0B0B0B;strokeColor=#D4FF3F;strokeWidth=2;fontFamily=Helvetica;fontSize=10;fontColor=#D4FF3F;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;" vertex="1" parent="md-gov">
          <mxGeometry x="1038" y="40" width="246" height="52" as="geometry" />
        </mxCell>
        <mxCell id="md-gov6" value="&lt;b&gt;SOX &amp;amp; sponsor contracts&lt;/b&gt;&lt;br&gt;Finance path segregation of duties&lt;br&gt;Contracted delivery SLAs, load-tested" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#D8D2C4;fontFamily=Helvetica;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;" vertex="1" parent="md-gov">
          <mxGeometry x="1294" y="40" width="262" height="52" as="geometry" />
        </mxCell>

        <mxCell id="md-nn" value="THE FIVE NON-NEGOTIABLES          —          what the reference diagram leaves out, and where the incident came from" style="swimlane;html=1;startSize=30;fillColor=#0B0B0B;strokeColor=#0B0B0B;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#D4FF3F;align=left;spacingLeft=14;letterSpacing=1;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="822" width="1570" height="86" as="geometry" />
        </mxCell>
        <mxCell id="md-n1" value="01  Bronze is&lt;br&gt;append-only" style="rounded=0;html=1;fillColor=#1F1F1F;strokeColor=#D4FF3F;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="md-nn">
          <mxGeometry x="14" y="36" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="md-n2" value="02  Contracts block,&lt;br&gt;they do not warn" style="rounded=0;html=1;fillColor=#1F1F1F;strokeColor=#D4FF3F;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="md-nn">
          <mxGeometry x="324" y="36" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="md-n3" value="03  Gold is persisted,&lt;br&gt;never a view chain" style="rounded=0;html=1;fillColor=#D4FF3F;strokeColor=#D4FF3F;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#0B0B0B;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="md-nn">
          <mxGeometry x="634" y="36" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="md-n4" value="04  Serving capacity is&lt;br&gt;isolated from ETL" style="rounded=0;html=1;fillColor=#1F1F1F;strokeColor=#D4FF3F;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="md-nn">
          <mxGeometry x="944" y="36" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="md-n5" value="05  One metric, one&lt;br&gt;definition, one owner" style="rounded=0;html=1;fillColor=#1F1F1F;strokeColor=#D4FF3F;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="md-nn">
          <mxGeometry x="1254" y="36" width="302" height="40" as="geometry" />
        </mxCell>

        <mxCell id="md-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1A7A1A;strokeWidth=3;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="md-src" target="md-bronze">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="md-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1A7A1A;strokeWidth=3;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="md-bronze" target="md-silver">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="md-e3" value="MERGE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1A7A1A;strokeWidth=3;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Helvetica;fontSize=10;fontColor=#1A7A1A;fontStyle=1;" edge="1" parent="1" source="md-silver" target="md-gold">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="md-e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1A7A1A;strokeWidth=3;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="md-gold" target="md-serve">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="md-foot" value="Structure follows the Microsoft reference medallion so the room recognises it. Five things are added: persistence stated explicitly, contracts as blocking gates, capacity isolation, a transactional plane, and a named owner per layer. Nothing here contradicts the reference pattern — it specifies the parts the reference pattern leaves to the implementer, which is where this estate diverged." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#8A7F66;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="918" width="1570" height="26" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
