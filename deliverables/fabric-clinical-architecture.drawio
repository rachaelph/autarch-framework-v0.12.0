        <mxCell id="gp-e2" value="recompute on every read" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D4FF3F;strokeWidth=3;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=10;fontColor=#1A7A1A;fontStyle=1;" edge="1" parent="1" source="gp-fab" target="gp-cons">
          <mxGeometry relative="1" as="geometry" />
