        <mxCell id="gp-g4" value="H4  No capacity isolation between ETL and serving&#10;      Test: request 90 days of capacity metrics" style="rounded=0;html=1;fillColor=#1F1F1F;strokeColor=#3A3A3A;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="gp-gaps">
          <mxGeometry x="14" y="248" width="362" height="56" as="geometry" />
        </mxCell>
        <mxCell id="gp-g5" value="H5  Metric definitions duplicated across Gold, models, DAX&#10;      Test: count definitions of 'enrolled subject'" style="rounded=0;html=1;fillColor=#1F1F1F;strokeColor=#3A3A3A;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="gp-gaps">
          <mxGeometry x="14" y="316" width="362" height="56" as="geometry" />
        </mxCell>
        <mxCell id="gp-g6" value="H6  Legacy and Fabric disagree on values, no arbiter&#10;      Test: ask where numbers differ and which one wins" style="rounded=0;html=1;fillColor=#1F1F1F;strokeColor=#3A3A3A;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="gp-gaps">
          <mxGeometry x="14" y="384" width="362" height="56" as="geometry" />
        </mxCell>

        <mxCell id="gp-cap" value="CAPTURE          Root cause class:                              Where else it applies:                              Evidence requested:                              Owner and date:" style="rounded=0;html=1;fillColor=#0B0B0B;strokeColor=#0B0B0B;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#D4FF3F;align=left;spacingLeft=16;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="80" y="700" width="1460" height="70" as="geometry" />
        </mxCell>
        <mxCell id="gp-foot" value="H1, H2, H4, H5 and H6 are inferred from the incident narrative and must be presented as hypotheses to test, not as findings. Only H3 is evidenced. Asserting the rest before discovery costs credibility in the room." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#8A7F66;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="785" width="1460" height="40" as="geometry" />
        </mxCell>

        <mxCell id="gp-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1A7A1A;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="gp-src" target="gp-fab">
