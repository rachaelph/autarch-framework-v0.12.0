{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "6215757793838810213"
    }
  },
  "parameters": {
    "functionAppName": {
      "type": "string",
      "defaultValue": "cict-ai-cus-func",
      "metadata": {
        "description": "Name of the Function App for invoice agent invocation."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for the Function App."
      }
    },
    "appServicePlanId": {
      "type": "string",
      "metadata": {
        "description": "Resource ID of the existing App Service Plan."
      }
    },
    "userAssignedIdentityResourceId": {
      "type": "string",
      "metadata": {
        "description": "Resource ID of the approved user-assigned managed identity."
      }
    },
    "userAssignedIdentityClientId": {
      "type": "string",
      "metadata": {
        "description": "Client ID of the approved user-assigned managed identity."
      }
    },
    "functionsStorageAccountName": {
      "type": "string",
      "metadata": {
        "description": "Storage account name for Azure Functions runtime."
      }
    },
    "serviceBusNamespace": {
      "type": "string",
      "metadata": {
        "description": "Service Bus namespace FQDN (e.g., cict-ai-cus-bus.servicebus.windows.net)."
      }
    },
    "serviceBusTopicName": {
      "type": "string",
      "defaultValue": "capex-invoice-ready-v1",
      "metadata": {
        "description": "Service Bus topic name (e.g., capex-invoice-ready-v1)."
      }
    },
    "serviceBusSubscriptionName": {
      "type": "string",
      "defaultValue": "invoice-agent-invocation",
      "metadata": {
        "description": "Service Bus subscription name for the function."
      }
    },
    "blobStorageAccountName": {
      "type": "string",
      "defaultValue": "cictaicusst",
      "metadata": {
        "description": "Azure Blob Storage account name for invoice packages."
      }
    },
    "blobContainer": {
      "type": "string",
      "defaultValue": "landing",
      "metadata": {
        "description": "Blob Storage container name."
      }
    },
    "sqlServerName": {
      "type": "string",
      "defaultValue": "cict-ai-cus-sql",
      "metadata": {
        "description": "Azure SQL logical server name."
      }
    },
    "sqlDatabaseName": {
      "type": "string",
      "defaultValue": "cict-ai-cus-sqldb",
      "metadata": {
        "description": "Azure SQL database name."
      }
    },
    "foundryEndpoint": {
      "type": "string",
      "metadata": {
        "description": "Azure OpenAI endpoint for the Foundry account."
      }
    },
    "foundryDeployment": {
      "type": "string",
      "defaultValue": "gpt-6.1-sol",
      "metadata": {
        "description": "Foundry deployment name."
      }
    },
    "taskRegion": {
      "type": "string",
      "defaultValue": "US",
      "metadata": {
        "description": "TaskMaster region used for task-code governance."
      }
    },
    "taskMasterSha256": {
      "type": "string",
      "defaultValue": "CC41B492A5DE454EFD7405066EF1EAA6CDE1FF050C8E71ED180831197B6EBA13",
      "metadata": {
        "description": "Approved TaskMaster workbook SHA-256."
      }
    },
    "taskPromptVersion": {
      "type": "string",
      "defaultValue": "task-determination-v1",
      "metadata": {
        "description": "Version of the Task Determination prompt contract."
      }
    },
    "applicationInsightsConnectionString": {
      "type": "securestring",
      "metadata": {
        "description": "Application Insights connection string."
      }
    }
  },
  "variables": {
    "blobAccountUrl": "[format('https://{0}.blob.{1}', parameters('blobStorageAccountName'), environment().suffixes.storage)]",
    "sqlServerFqdn": "[format('{0}.{1}', parameters('sqlServerName'), environment().suffixes.sqlServerHostname)]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2024-04-01",
      "name": "[parameters('functionAppName')]",
      "location": "[parameters('location')]",
      "kind": "functionapp",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', parameters('userAssignedIdentityResourceId'))]": {}
        }
      },
      "properties": {
        "serverFarmId": "[parameters('appServicePlanId')]",
        "httpsOnly": true,
        "siteConfig": {
          "appSettings": [
            {
              "name": "AzureWebJobsStorage__accountName",
              "value": "[parameters('functionsStorageAccountName')]"
            },
            {
              "name": "AzureWebJobsStorage__credential",
              "value": "managedidentity"
            },
            {
              "name": "AzureWebJobsStorage__clientId",
              "value": "[parameters('userAssignedIdentityClientId')]"
            },
            {
              "name": "FUNCTIONS_EXTENSION_VERSION",
              "value": "~4"
            },
            {
              "name": "FUNCTIONS_WORKER_RUNTIME",
              "value": "python"
            },
            {
              "name": "SCM_DO_BUILD_DURING_DEPLOYMENT",
              "value": "true"
            },
            {
              "name": "ENABLE_ORYX_BUILD",
              "value": "true"
            },
            {
              "name": "WEBSITE_USE_PLACEHOLDER",
              "value": "0"
            },
            {
              "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
              "value": "[parameters('applicationInsightsConnectionString')]"
            },
            {
              "name": "ApplicationInsightsAgent_EXTENSION_VERSION",
              "value": "~3"
            },
            {
              "name": "XDT_MicrosoftApplicationInsights_Mode",
              "value": "default"
            },
            {
              "name": "ServiceBusConnection__fullyQualifiedNamespace",
              "value": "[parameters('serviceBusNamespace')]"
            },
            {
              "name": "ServiceBusConnection__credential",
              "value": "managedidentity"
            },
            {
              "name": "ServiceBusConnection__clientId",
              "value": "[parameters('userAssignedIdentityClientId')]"
            },
            {
              "name": "CAPEX_SERVICE_BUS_TOPIC",
              "value": "[parameters('serviceBusTopicName')]"
            },
            {
              "name": "CAPEX_SERVICE_BUS_SUBSCRIPTION",
              "value": "[parameters('serviceBusSubscriptionName')]"
            },
            {
              "name": "CAPEX_BLOB_ACCOUNT_URL",
              "value": "[variables('blobAccountUrl')]"
            },
            {
              "name": "CAPEX_BLOB_CONTAINER",
              "value": "[parameters('blobContainer')]"
            },
            {
              "name": "CAPEX_SQL_SERVER",
              "value": "[variables('sqlServerFqdn')]"
            },
            {
              "name": "CAPEX_SQL_DATABASE",
              "value": "[parameters('sqlDatabaseName')]"
            },
            {
              "name": "AZURE_CLIENT_ID",
              "value": "[parameters('userAssignedIdentityClientId')]"
            },
            {
              "name": "FOUNDRY_ENDPOINT",
              "value": "[parameters('foundryEndpoint')]"
            },
            {
              "name": "FOUNDRY_DEPLOYMENT",
              "value": "[parameters('foundryDeployment')]"
            },
            {
              "name": "CAPEX_TASK_REGION",
              "value": "[parameters('taskRegion')]"
            },
            {
              "name": "CAPEX_TASK_MASTER_SHA256",
              "value": "[parameters('taskMasterSha256')]"
            },
            {
              "name": "CAPEX_TASK_PROMPT_VERSION",
              "value": "[parameters('taskPromptVersion')]"
            }
          ],
          "pythonVersion": "3.12",
          "use32BitWorkerProcess": false,
          "webSocketsEnabled": false,
          "managedPipelineMode": "Integrated",
          "remoteDebuggingEnabled": false,
          "http20Enabled": true
        }
      }
    }
  ],
  "outputs": {
    "functionAppId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Web/sites', parameters('functionAppName'))]"
    },
    "functionAppName": {
      "type": "string",
      "value": "[parameters('functionAppName')]"
    },
    "functionAppUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/sites', parameters('functionAppName')), '2024-04-01').defaultHostName)]"
    },
    "identityResourceId": {
      "type": "string",
      "value": "[parameters('userAssignedIdentityResourceId')]"
    },
    "identityClientId": {
      "type": "string",
      "value": "[parameters('userAssignedIdentityClientId')]"
    }
  }
}