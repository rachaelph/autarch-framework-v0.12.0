FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV CAPEX_INPUT_DIR=/input
ENV CAPEX_OUTPUT_DIR=/output

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
    && curl -sSL \
        https://packages.microsoft.com/config/debian/12/packages-microsoft-prod.deb \
        -o /tmp/packages-microsoft-prod.deb \
    && dpkg -i /tmp/packages-microsoft-prod.deb \
    && rm /tmp/packages-microsoft-prod.deb \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y --no-install-recommends \
        msodbcsql18 \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --uid 10001 capex

WORKDIR /app

COPY pyproject.toml README.md ./
COPY autarch ./autarch

RUN pip install --no-cache-dir ".[capex]" \
    && mkdir -p /input /output \
    && chown -R capex:capex /app /input /output

USER capex

VOLUME ["/input", "/output"]

ENTRYPOINT ["capex-prepare-blob"]
