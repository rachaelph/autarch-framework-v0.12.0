{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://circlek.com/schemas/capex/invoice-ready-v1.schema.json",
  "title": "Circle K CapEx InvoiceReady v1",
  "description": "Notification-only event published after an InvoicePackage transaction commits.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "invoiceId",
    "packageId",
    "runId",
    "packageUri",
    "occurredAtUtc",
    "correlationId"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "eventType": {
      "const": "InvoiceReady"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "invoiceId": {
      "type": "string",
      "minLength": 1
    },
    "packageId": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "packageUri": {
      "type": "string",
      "minLength": 1,
      "format": "uri-reference"
    },
    "occurredAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    }
  }
}